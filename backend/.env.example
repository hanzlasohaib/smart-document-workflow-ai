# Copy to backend/.env and fill in real values. Never commit .env.

# Required
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql://sdw:sdw@localhost:5432/smart_docs
UPLOAD_DIR=./uploads

# Sessions (PAS-03)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage (PAS-02): local | supabase
STORAGE_BACKEND=local
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_STORAGE_BUCKET=documents

# Pipeline
CONFIDENCE_THRESHOLD=0.70
# MODEL_PATH=./document_classifier.pkl

# Admin seed (python -m scripts.seed_admin) — staging/ops only
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Administrator

# Browser FE origins (comma-separated) for CORS
CORS_ORIGINS=http://localhost:3000
