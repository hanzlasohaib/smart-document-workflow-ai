# Copy to backend/.env and fill in real values. Never commit .env.

# Required
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql://sdw:sdw@localhost:5432/smart_docs
UPLOAD_DIR=./uploads

# Sessions (PAS-03)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage (PAS-02): local | supabase
STORAGE_BACKEND=local
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_STORAGE_BUCKET=documents

# Pipeline
CONFIDENCE_THRESHOLD=0.70
# MODEL_PATH=./document_classifier.pkl

# Admin seed (python -m scripts.seed_admin) — staging/ops only
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Administrator
# Admin login OTP destination (Resend). Defaults to ADMIN_EMAIL when unset.
ADMIN_OTP_EMAIL=hanzlamaan125@gmail.com
ADMIN_OTP_EXPIRE_MINUTES=10
ADMIN_OTP_MAX_ATTEMPTS=5
ADMIN_OTP_LENGTH=6

# Browser FE origins (comma-separated) for CORS
CORS_ORIGINS=http://localhost:3000

# Observability (P3)
LOG_FORMAT=json
# Paste your project DSN from Sentry → Settings → Client Keys (never commit a real DSN).
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.1
# Temporary verification only — leave false in production; disable after testing.
SENTRY_ENABLE_DEBUG_ENDPOINT=false

# Auth rate limit (per client IP). Set REQUESTS=0 to disable.
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Transactional email (Resend) — optional; leave unset to skip sending
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=Smart Docs <onboarding@resend.dev>
